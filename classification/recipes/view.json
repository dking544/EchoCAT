{
  "model": {
    "backbone": {
      "type": "TinyViT",
      "arch": "21m",
      "img_size": [
        224,
        224
      ],
      "window_size": [
        7,
        7,
        14,
        7
      ],
      "out_indices": [
        3
      ],
      "drop_path_rate": 0.2,
      "gap_before_final_norm": true,
      "init_cfg": [
        {
          "type": "TruncNormal",
          "layer": [
            "Conv2d",
            "Linear"
          ],
          "std": 0.02,
          "bias": 0.0
        },
        {
          "type": "Constant",
          "layer": [
            "LayerNorm"
          ],
          "val": 1.0,
          "bias": 0.0
        }
      ]
    },
    "head": {
      "type": "LinearClsHead",
      "num_classes": 2,
      "in_channels": 576,
      "loss": {
        "type": "CrossEntropyLoss",
        "loss_weight": 1.0
      }
    }
  },
  "train_pipeline": [
    {
      "type": "LoadImageFromFile"
    },
    {
      "type": "BGRToGrayThreeChannel"
    },
    {
      "type": "RandomResizedCrop",
      "size": 224,
      "backend": "pillow"
    },
    {
      "type": "ForegroundPercentileWindowThreeChannel"
    },
    {
      "type": "RandomFlip",
      "flip_prob": 0.5,
      "direction": "horizontal"
    },
    {
      "type": "PairedUltrasoundStyleToTensor",
      "p": 0.8,
      "mean": [
        123.675,
        116.28,
        103.53
      ],
      "std": [
        58.395,
        57.12,
        57.375
      ]
    },
    {
      "type": "ToTensor",
      "keys": [
        "gt_label"
      ]
    },
    {
      "type": "Collect",
      "keys": [
        "img",
        "gt_label"
      ]
    }
  ],
  "val_pipeline": [
    {
      "type": "LoadImageFromFile"
    },
    {
      "type": "BGRToGrayThreeChannel"
    },
    {
      "type": "Resize",
      "size": [
        256,
        -1
      ],
      "backend": "pillow"
    },
    {
      "type": "CenterCrop",
      "crop_size": 224
    },
    {
      "type": "ForegroundPercentileWindowThreeChannel"
    },
    {
      "type": "Normalize",
      "mean": [
        123.675,
        116.28,
        103.53
      ],
      "std": [
        58.395,
        57.12,
        57.375
      ],
      "to_rgb": true
    },
    {
      "type": "ImageToTensor",
      "keys": [
        "img"
      ]
    },
    {
      "type": "Collect",
      "keys": [
        "img"
      ]
    }
  ],
  "data": {
    "batch_size": 16,
    "num_workers": 4,
    "train": {
      "pretrained_flag": false,
      "pretrained_weights": "",
      "freeze_flag": false,
      "freeze_layers": [
        "backbone"
      ],
      "epoches": 100,
      "baseline_val_acc": 0.0,
      "model_selection": {
        "mode": "constrained_balanced_accuracy",
        "sensitivity_min": 0.9,
        "specificity_min": 0.9
      },
      "paired_consistency": {
        "type": "jensen_shannon",
        "weight": 0.5,
        "style_probability": 0.8,
        "shared_geometry": true
      }
    },
    "test": {
      "ckpt": "",
      "metrics": [
        "accuracy",
        "precision",
        "recall",
        "f1_score",
        "confusion"
      ],
      "metric_options": {
        "topk": [
          1,
          5
        ],
        "thrs": null,
        "average_mode": "none"
      }
    }
  },
  "lr": {
    "type": "CosineAnnealingLrUpdater",
    "by_epoch": false,
    "min_lr_ratio": 0.01,
    "warmup": "linear",
    "warmup_ratio": 0.001,
    "warmup_iters": 3,
    "warmup_by_epoch": true
  },
  "optimizer": {
    "type": "AdamW",
    "lr": 3.125e-05,
    "weight_decay": 0.05,
    "eps": 1e-08,
    "betas": [
      0.9,
      0.999
    ]
  }
}
